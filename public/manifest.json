{
  "manifest_version": 3,
  "name": "J's TAB",
  "description": "A calm, customizable bookmark library for your new tab.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Save this tab to J's TAB",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "bookmarks",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://www.google.com/*",
    "https://picsum.photos/*",
    "https://fastly.picsum.photos/*"
  ]
}
